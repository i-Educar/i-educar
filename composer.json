            "iEducar\\Packages\\GestaoPresente\\": "packages/serventec/i-educar-gestao-presente-package/src/",
            "iEducar\\Packages\\GovbrLogin\\": "packages/serventec/i-educar-govbr-login-package/src/",
            "iEducar\\Packages\\Hamburger\\": "packages/serventec/i-educar-hamburger-package/src/",
